page {
  --text-primary: #2c3e50;
  --text-secondary: #7f8c8d;
  --bg-page: #f5f5f5;
  --bg-card: #ffffff;
  --bg-subtle: #f0f0f0;
  --line: #f0f0f0;
  background-color: var(--bg-page);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  color: var(--text-primary);
  height: 100%;
}

/* 深色模式 */
@media (prefers-color-scheme: dark) {
  page {
    --text-primary: #e6e6e6;
    --text-secondary: #9a9a9a;
    --bg-page: #121212;
    --bg-card: #1e1e1e;
    --bg-subtle: #2a2a2c;
    --line: #2a2a2c;
  }
}